# Server only. Set secrets directly in Vercel; do not populate this tracked file.
APP_URL=
SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Optional: enable the unofficial Garmin adapter only for explicit experiments.
ENABLE_EXPERIMENTAL_GARMIN=false

# Personal Garmin data: bind the server key to your numeric Strava athlete ID.
GARMIN_CONNECT_API_KEY=
GARMIN_PERSONAL_STRAVA_ID=
